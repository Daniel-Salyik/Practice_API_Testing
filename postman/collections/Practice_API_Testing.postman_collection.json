      "name": "Booking",
      "item": [
        {
          "name": "CreateBooking",
          "item": [
            {
              "name": "[CREATE_001] Valid booking creation",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "exec": [
                      ""
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test(\"Response matches request data\", () => {",
                      "",
                      "const requestBody = JSON.parse(pm.request.body.raw);",
                      "const resBody = pm.response.json();",
                      "",
                      "    pm.expect(resBody.booking.firstname).to.eql(requestBody.firstname);",
                      "    pm.expect(resBody.booking.lastname).to.eql(requestBody.lastname);",
                      "    pm.expect(resBody.booking.totalprice).to.eql(requestBody.totalprice);",
                      "    pm.expect(resBody.booking.bookingdates.checkin).to.eql(requestBody.bookingdates.checkin);",
                      "    pm.expect(resBody.booking.bookingdates.checkout).to.eql(requestBody.bookingdates.checkout);",
                      "",
                      "",
                      "});"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"firstname\": \"Sally\",\n  \"lastname\": \"Brown\",\n  \"totalprice\": 150,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-07-01\",\n    \"checkout\": \"2026-07-10\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{base_URL}}/booking",
                  "host": [
                    "{{base_URL}}"
                  ],
                  "path": [
                    "booking"
                  ]
                }
              },
              "response": []
            },
