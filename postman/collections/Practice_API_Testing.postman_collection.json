                      "const requestBody = JSON.parse(pm.request.body.raw);",
                      "const resBody = pm.response.json();",
                      "",
                      "    pm.expect(resBody.booking.firstname).to.eql(requestBody.firstname);",
                      "    pm.expect(resBody.booking.lastname).to.eql(requestBody.lastname);",
                      "    pm.expect(resBody.booking.totalprice).to.eql(requestBody.totalprice);",
                      "    pm.expect(resBody.booking.bookingdates.checkin).to.eql(requestBody.bookingdates.checkin);",
                      "    pm.expect(resBody.booking.bookingdates.checkout).to.eql(requestBody.bookingdates.checkout);",
