                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const requestBody = JSON.parse(pm.request.body.raw);",
                      "const responseBody = pm.response.json();",
                      "",
                      "pm.test(\"Response matches request data\", () => {",
                      "    pm.expect(responseBody.booking.firstname).to.eql(requestBody.firstname);",
                      "    pm.expect(responseBody.booking.lastname).to.eql(requestBody.lastname);",
                      "    pm.expect(responseBody.booking.totalprice).to.eql(requestBody.totalprice);",
                      "    pm.expect(responseBody.booking.bookingdates.checkin).to.eql(requestBody.bookingdates.checkin);",
                      "    pm.expect(responseBody.booking.bookingdates.checkout).to.eql(requestBody.bookingdates.checkout);",
                      "",
                      "",
                      "});"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"firstname\": \"Sally\",\n  \"lastname\": \"Brown\",\n  \"totalprice\": 150,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-07-01\",\n    \"checkout\": \"2026-07-10\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}",
                  "options": {
